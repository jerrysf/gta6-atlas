# Base URL of the deployed site (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (optional — analytics disabled when unset)
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX (optional — ads disabled when unset)
NEXT_PUBLIC_ADSENSE_ID=

# Affiliate pre-order URL for GTA VI (optional — when set, pre-order CTAs link
# through it and are labeled as affiliate links; otherwise they link to
# Rockstar's official page)
NEXT_PUBLIC_PREORDER_URL=

# Supabase (optional — the MVP runs on static data files without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_NEWSLETTER_URL=
